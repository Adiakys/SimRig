// SimRig: the main window.

import { Theme, Icons } from "theme.slint";
import { Rig, Api, Toast } from "api.slint";
import { Geometry } from "devices.slint";
import { Button, ButtonKind } from "widgets.slint";
import { Home } from "home.slint";
import { ComponentScreen } from "component.slint";
import { ProcedureScreen } from "procedure.slint";
import { AddScreen, PluginsScreen, SettingsScreen, FirstRunScreen } from "flows.slint";
import { UpdateNotice, UpdateWindow } from "update.slint";

export { Theme, Rig, Api, Geometry }

export enum Screen { home, component, procedure, add, plugins, settings, first-run }

/// Thin top bar: the mark and the name on the left; the update notice, Settings, Plugins and Add
/// device on the right.
component TopBar inherits Rectangle {
    in property <Screen> screen;
    in property <bool> actions: true;
    callback settings;
    callback plugins;
    callback add;
    callback update;
    height: 44px;
    background: Theme.surface;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 12px;
        spacing: 4px;
        HorizontalLayout {
            spacing: 10px;
            horizontal-stretch: 0;
            Image {
                source: Icons.mark;
                width: 22px;
                height: 22px;
                y: (parent.height - 22px) / 2;
                accessible-role: AccessibleRole.image;
                accessible-label: "SimRig";
            }
            Text {
                text: "SimRig";
                font-family: Theme.sans;
                font-size: 17px;
                font-weight: 600;
                color: Theme.ink;
                vertical-alignment: center;
            }
        }
        Rectangle { horizontal-stretch: 1; }
        if Rig.update.available: VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            padding-right: 8px;
            UpdateNotice {
                clicked => { root.update(); }
            }
        }
        if root.actions: VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            Button {
                kind: ButtonKind.quiet;
                icon: Icons.gear;
                text: @tr("Settings");
                active: root.screen == Screen.settings;
                clicked => { root.settings(); }
            }
        }
        if root.actions: VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            Button {
                kind: ButtonKind.quiet;
                icon: Icons.plug;
                text: @tr("Plugins");
                badge: Rig.drivers-outdated > 0;
                active: root.screen == Screen.plugins;
                clicked => { root.plugins(); }
            }
        }
        if root.actions: VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            padding-left: 4px;
            Button {
                kind: ButtonKind.outline;
                icon: Icons.add-device;
                text: @tr("Add device");
                active: root.screen == Screen.add;
                clicked => { root.add(); }
            }
        }
    }
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.line;
    }
}

/// A confirmation or an error: its icon, the text and a close button on one line, the text
/// wrapping under its first line.
component ToastCard inherits Rectangle {
    in property <Toast> toast;
    callback dismiss;
    property <color> fg: toast.level == "success" ? Theme.success : toast.level == "warning" ? Theme.warning
        : toast.level == "error" ? Theme.error : Theme.ink2;
    height: row.preferred-height;
    border-radius: 10px;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.dark ? Theme.rule : Theme.line;
    drop-shadow-blur: Theme.float-blur;
    drop-shadow-offset-y: 8px;
    drop-shadow-color: Theme.float-shadow;
    accessible-role: AccessibleRole.text;
    accessible-label: toast.text;
    row := HorizontalLayout {
        padding-left: 14px;
        padding-right: 6px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 10px;
        // Icon, first line of text and close button share a 28px line.
        VerticalLayout {
            alignment: start;
            padding-top: 5px;
            Image {
                source: root.toast.level == "success" ? Icons.check : root.toast.level == "warning" ? Icons.warn
                    : root.toast.level == "error" ? Icons.error : Icons.info;
                colorize: root.fg;
                width: 18px;
                height: 18px;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            padding-top: 5px;
            padding-bottom: 5px;
            Text {
                text: root.toast.text;
                font-family: Theme.sans;
                font-size: 15px;
                color: Theme.ink;
                wrap: word-wrap;
                vertical-alignment: top;
            }
        }
        VerticalLayout {
            alignment: start;
            close := TouchArea {
                width: 28px;
                height: 28px;
                mouse-cursor: pointer;
                accessible-role: AccessibleRole.button;
                accessible-label: @tr("Dismiss");
                accessible-action-default => { root.dismiss(); }
                clicked => { root.dismiss(); }
                Rectangle {
                    border-radius: 6px;
                    background: close.has-hover ? Theme.raised : transparent;
                }
                Image {
                    source: Icons.x;
                    colorize: Theme.ink2;
                    width: 16px;
                    height: 16px;
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    in-out property <Screen> screen: Screen.home;
    callback navigate(Screen);

    title: "SimRig";
    icon: Icons.mark;
    min-width: 1100px;
    min-height: 700px;
    preferred-width: 1440px;
    preferred-height: 900px;
    background: Theme.bg;
    default-font-family: "Barlow";
    default-font-size: 16px;

    init => {
        Theme.window-width = self.width;
        Theme.window-height = self.height;
    }
    changed width => { Theme.window-width = self.width; }
    changed height => { Theme.window-height = self.height; }

    FocusScope {
        key-pressed(e) => {
            if e.text == Key.Escape && Rig.update-open {
                Rig.update-open = Rig.update.stage == "downloading" || Rig.update.stage == "installing";
                return accept;
            }
            if e.text == Key.Escape && root.screen != Screen.home {
                Api.go-home();
                return accept;
            }
            reject
        }

        VerticalLayout {
            TopBar {
                screen: root.screen;
                actions: root.screen != Screen.first-run;
                settings => { root.navigate(Screen.settings); }
                plugins => { root.navigate(Screen.plugins); }
                add => { Api.start-add(); }
                update => { Rig.update-open = true; }
            }
            Rectangle {
                vertical-stretch: 1;
                if root.screen == Screen.home: Home { }
                if root.screen == Screen.component: ComponentScreen { }
                if root.screen == Screen.procedure: ProcedureScreen { }
                if root.screen == Screen.add: AddScreen { }
                if root.screen == Screen.plugins: PluginsScreen { }
                if root.screen == Screen.settings: SettingsScreen { }
                if root.screen == Screen.first-run: FirstRunScreen { }
            }
        }
    }

    if Rig.update-open && Rig.update.available: UpdateWindow {
        close => { Rig.update-open = false; }
    }

    // Toasts: confirmations and errors, under the top bar, never modal.
    toasts := VerticalLayout {
        x: (parent.width - self.width) / 2;
        y: 44px + 12px;
        width: 440px;
        height: self.preferred-height;
        spacing: 8px;
        for t[i] in Rig.toasts: ToastCard {
            toast: t;
            dismiss => { Api.dismiss-toast(i); }
        }
    }
}
