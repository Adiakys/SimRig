#!/bin/sh
# Installs the Generic USB driver: the service binary, its systemd unit and (empty) udev rules.
set -eu
. "$SIMRIG_DRIVER_DIR/hooks/common.sh"
mkdir -p "$DATA/devices" "$DATA/allowed" "$DATA/bin"

if ! system_mode; then
    touch "$DATA/installed"
    echo "development install: setups are kept in $DATA; no udev rules or service (needs root)"
    exit 0
fi

# The service ships inside the driver (bin/): hooks run from the copy of the driver SimRig keeps
# in its state directory, not from the plugin's.
if [ -x "$SIMRIG_DRIVER_DIR/bin/simrig-generic-usb-service" ]; then
    mkdir -p "$(dirname "$SERVICE")"
    install -m 0755 "$SIMRIG_DRIVER_DIR/bin/simrig-generic-usb-service" "$SERVICE"
else
    echo "simrig-generic-usb-service is missing from the driver ($SIMRIG_DRIVER_DIR/bin)" >&2
    exit 1
fi
command -v systemctl >/dev/null || { echo "systemd is required to start the service with the device" >&2; exit 1; }

mkdir -p "$(dirname "$UNIT")"
cat > "$UNIT" <<UNIT
# Installed by the SimRig Generic USB driver. Started by udev for a set-up device.
[Unit]
Description=SimRig Generic USB device %I
BindsTo=dev-%i.device
After=dev-%i.device

[Service]
ExecStart=$SERVICE %I $DATA/devices
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
UNIT
systemctl daemon-reload
write_rules
touch "$DATA/installed"
echo "Generic USB driver installed"
