#!/bin/sh
# Builds and installs hid-fanatecff with DKMS, then SimRig's udev rules. Upgrades a version
# SimRig installed before; leaves a hid-fanatec installed by other means alone.
set -eu
. "$SIMRIG_DRIVER_DIR/hooks/common.sh"
mkdir -p "$DATA"

if [ "$(id -u)" != 0 ]; then
    echo "$VERSION" > "$DATA/dev-installed"
    echo "development install: hid-fanatecff is not built (needs root)"
    exit 0
fi

# A hid-fanatec installed by other means is used as it is: only SimRig's udev rules are added
# (access without a password, settings saved at plug-in), the module is never touched.
if other=$(mod_foreign "$PACKAGE" "$MODULE"); then
    rules
    udev_apply $SUBSYSTEMS
    echo "$other" > "$DATA/integration"
    echo "hid-fanatec $other is installed, not by SimRig: it is used as it is, with SimRig's access rules"
    exit 0
fi

mod_prerequisites
rules
rc=0
mod_build "$PACKAGE" "$VERSION" "$SOURCE" dkms.conf "$MODULE" || rc=$?
case $rc in
0)
    hid_rebind 0EB7 fanatec
    udev_apply $SUBSYSTEMS
    echo "hid-fanatec $VERSION installed"
    ;;
3)
    udev_apply hidraw
    echo "hid-fanatec $VERSION installed: $(mod_key_message)"
    ;;
*) exit 1 ;;
esac
