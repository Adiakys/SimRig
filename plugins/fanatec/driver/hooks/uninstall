#!/bin/sh
# Removes what SimRig installed: its DKMS version of hid-fanatecff and its udev rules. Never a
# hid-fanatec installed by other means. Works on partial installs.
set -eu
. "$SIMRIG_DRIVER_DIR/hooks/common.sh"

if [ "$(id -u)" = 0 ]; then
    mod_remove "$PACKAGE" "$MODULE"
    udev_remove "$RULES"
    udev_apply hid hidraw
    rm -f "$ROOT/etc/modprobe.d/simrig-fanatec.conf"
fi
rm -f "$DATA/$PACKAGE.installed" "$DATA/integration" "$DATA/mok-pending" "$DATA/dev-installed" "$DATA/init_range"
echo "SimRig's Fanatec driver removed"
