#!/bin/sh
# Runs as the user: the state of the Fanatec driver, as JSON.
set -eu
. "$SIMRIG_DRIVER_DIR/hooks/common.sh"

active=false
mod_loaded "$MODULE" && active=true
set -- $(mod_state "$PACKAGE" "$MODULE" "$VERSION")
case $1 in
pending)
    status_json true false "$2" true false true "To trust the key that signs the driver: $(mod_key_message)."
    ;;
outdated)
    status_json true "$active" "$2" false false true "Version $VERSION of the driver is available."
    ;;
ours)
    status_json true "$active" "$2" false false true ""
    ;;
*)
    if [ -f "$DATA/dev-installed" ]; then
        status_json true false "$VERSION" false false true "Development install: hid-fanatecff is not built."
    elif [ -f "$DATA/integration" ]; then
        other=${2:-$(cat "$DATA/integration")}
        status_json true "$active" "$other" false false true \
            "Uses hid-fanatec $other installed by you or your distribution (SimRig is tested with $VERSION)."
    elif [ "$1" = foreign ]; then
        # Someone else's module: SimRig still offers its access rules and saved settings.
        status_json false false "$2" false false true \
            "hid-fanatec $2 is installed (by you or your distribution): SimRig keeps it and adds its access rules. Asks for the password once."
    else
        status_json false false "" false false true \
            "Builds the open source hid-fanatecff driver for your kernel. Asks for the password once."
    fi
    ;;
esac
