#!/bin/sh
# Runs as the user: the state of the Fanatec driver, as JSON.
set -eu
. "$SIMRIG_DRIVER_DIR/hooks/common.sh"

mine=$(ours)
if [ -n "$mine" ]; then
    active=false
    loaded && active=true
    if [ -f "$DATA/mok-pending" ] && ! loaded; then
        status_json true false "$mine" true false true \
            "Restart, choose \"Enroll MOK\" and type $(cat "$DATA/mok-pending") to trust the key that signs the driver."
    elif [ "$mine" != "$VERSION" ]; then
        status_json true "$active" "$mine" false false true "Version $VERSION of the driver is available."
    else
        status_json true "$active" "$mine" false false true ""
    fi
elif [ -f "$DATA/dev-installed" ]; then
    status_json true false "$VERSION" false false true "Development install: hid-fanatecff is not built."
elif [ -f "$DATA/integration" ]; then
    other=$(foreign || cat "$DATA/integration")
    active=false
    loaded && active=true
    status_json true "$active" "$other" false false true \
        "Uses hid-fanatec $other installed by you or your distribution (SimRig is tested with $VERSION)."
elif other=$(foreign); then
    # Someone else's module: SimRig still offers its access rules and saved settings.
    status_json false false "$other" false false true \
        "hid-fanatec $other is installed (by you or your distribution): SimRig keeps it and adds its access rules. Asks for the password once."
else
    status_json false false "" false false true \
        "Builds the open source hid-fanatecff driver for your kernel. Asks for the password once."
fi
