#!/bin/sh
# Saves a setting of a base model for the next time it is plugged in: a udev rule that writes
# simagic-ff's attribute when it binds to the base. One line per model and attribute.
set -eu
. "$SIMRIG_DRIVER_DIR/hooks/common.sh"
model="$SIMRIG_ARG_MODEL"
attr="$SIMRIG_ARG_ATTR"
value="$SIMRIG_ARG_VALUE"
match="KERNEL==\"0003:$model.*\", ATTR{$attr}="
line="ACTION==\"bind\", SUBSYSTEM==\"hid\", DRIVER==\"simagic-ff\", $match\"$value\""

if [ "$(id -u)" = 0 ]; then
    file="$(udev_rules_dir)/$SETTINGS"
    mkdir -p "$(udev_rules_dir)"
else
    # Development: kept in the driver's data.
    mkdir -p "$DATA"
    file="$DATA/settings"
fi
{
    echo "# Written by SimRig: Simagic base settings applied when the base is plugged in."
    grep -vF "$match" "$file" 2>/dev/null | grep -v '^#' || true
    echo "$line"
} > "$file.new"
mv "$file.new" "$file"
if [ "$(id -u)" = 0 ]; then
    udevadm control --reload
fi
echo "$attr $value saved"
