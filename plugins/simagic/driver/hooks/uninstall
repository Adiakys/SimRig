#!/bin/sh
# Removes what SimRig installed: its DKMS version of simagic-ff, its udev rules and saved
# settings. Never a simagic-ff installed by other means. Works on partial installs.
set -eu
. "$SIMRIG_DRIVER_DIR/hooks/common.sh"

if [ "$(id -u)" = 0 ]; then
    mod_remove "$PACKAGE" "$MODULE"
    udev_remove "$RULES"
    udev_remove "$SETTINGS"
    udev_apply hid hidraw
fi
for file in "$PACKAGE.installed" integration mok-pending dev-installed rules settings; do
    rm -f "${DATA:?}/$file"
done
echo "SimRig's Simagic driver removed"
