#!/bin/sh
# Builds and installs hid-tmff2 with DKMS, and hid-t150 if a T150 or TMX is plugged in, then
# SimRig's udev rules. Upgrades what SimRig installed before; leaves modules installed by other
# means alone.
set -eu
. "$SIMRIG_DRIVER_DIR/hooks/common.sh"
mkdir -p "$DATA"

if [ "$(id -u)" != 0 ]; then
    echo "$VERSION" > "$DATA/dev-installed"
    echo "development install: hid-tmff2 is not built (needs root)"
    exit 0
fi

udev_install "$RULES" < "$SIMRIG_DRIVER_DIR/udev/$RULES"

rc=0
if other=$(mod_foreign "$PACKAGE" "$MODULE"); then
    # A hid-tmff2 installed by other means is used as it is.
    echo "$other" > "$DATA/integration"
    echo "hid-tmff2 $other is installed, not by SimRig: it is used as it is, with SimRig's access rules"
else
    mod_prerequisites
    mod_build "$PACKAGE" "$VERSION" "$SOURCE" dkms/dkms.conf $INIT_MODULES "$MODULE" || rc=$?
    # hid-tminit's modules start the wheels from now on.
    write_conf
    modprobe -r hid_thrustmaster 2>/dev/null || true
    case $rc in
    0)
        # Wheels start again, as if replugged: hid-tminit starts them up and hid-tmff2 takes
        # them.
        usb_replug 044f
        echo "hid-tmff2 $VERSION installed"
        ;;
    3) echo "hid-tmff2 $VERSION installed" ;;
    *) exit 1 ;;
    esac
fi

t150=0
t150_ensure || t150=$?
[ "$t150" = 1 ] && exit 1

udev_apply hid hidraw
if [ "$rc" = 3 ] || [ "$t150" = 3 ]; then
    echo "Thrustmaster driver installed: $(mod_key_message)"
fi
